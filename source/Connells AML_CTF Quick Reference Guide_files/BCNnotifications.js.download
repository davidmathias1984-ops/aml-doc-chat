// If the BEACON object does not already exist create a new object.
var BEACON = BEACON === undefined ? {} : BEACON;
var MLLabels = ["VIEW_ALL_SCASE", "YOU_HAVE_A_LOT_OF_NEW_NOTIFICATIONS_EMARK_SCASE", "DELETE_NOTIFICATION_SCASE", "TURN_ON_EMAIL_NOTIFICATIONS_SCASE", "TURN_OFF_EMAIL_NOTIFICATIONS_SCASE", "EMAIL", "TURN_OFF_POP_UP_NOTIFICATIONS_SCASE", "POPUP", "TURN_ON_POP_UP_NOTIFICATIONS_SCASE", "TURN_ON_NOTIFICATIONS_SCASE", "TURN_OFF", "TURN_OFF_NOTIFICATIONS_SCASE", "PREFERENCES_FOR_NOTIFICATIONS_LIKE_THIS", "TOGGLE_PREFERENCES_FOR_COLON_SCASE", "VIEW_CONTENT_SCASE", "DISMISS_NOTIFICATION_SCASE", "TOGGLE_NOTIFICATION_SOUNDS_SCASE", "NOTIFICATIONS", "THERE_ARE_CURRENTLY_NO_ACTIVE_NOTIFICATIONS_SCASE", "GO_TO_THE_NOTIFICATIONS_PAGE_SCASE", "VIEW_ALL_SCASE"];

///
///  Notification local call method
///

function notification(AlertText,AlertBody,DismissButtonText) {

    var uniqueID = Math.floor((Math.random() * 10000000) + 1);
    var newNotification = new BEACON.notifications.notification(uniqueID, BEACON.notifications.types.INTRUSIVE);

    newNotification.Stored = false;
    newNotification.Sticky = false;

    newNotification.NotificationTitle = AlertText;

    if (AlertBody)newNotification.BodyText = AlertBody;
    if (DismissButtonText)newNotification.NotificationDismissButtonText = DismissButtonText;

    //Send to the system
    CreateNotificationFromObject(newNotification);
}

function informationalNotification(AlertText) {

    var uniqueID = Math.floor((Math.random() * 10000000) + 1);
    var newNotification = new BEACON.notifications.notification(uniqueID, BEACON.notifications.types.INFORMATIONAL);

    newNotification.Stored = false;
    newNotification.Sticky = false;

    newNotification.NotificationTitle = AlertText;
    //User this for a default image
    //newNotification.NotificationImage = '';

    //Send to the system
    CreateNotificationFromObject(newNotification);
}

//The method for creating an alert - this will be used instead of alert();
function CreateNotificationFromObject(notificationObject) {

    //Insert the notification into memory
    BEACON.notifications.CORE.InjectNotification(BEACON.notifications.CORE.ProcessNotification(notificationObject));

    //Display the notification
    if (BEACON.notifications.CORE.ActiveBlockingNotification === false || BEACON.notifications.CORE.ActiveIntrusiveNotification === false) { //Only process if there is no blocking or intrusive notification showing - this overrides everything

        if (BEACON.notifications.UI.DoesNotificationAlreadyExist(notificationObject) === true) {
            BEACON.notifications.UI.UpdateNotificationInPage(notificationObject);
        }
        else {
            BEACON.notifications.CORE.DisplayNotification(notificationObject);
        }

    }

}


///
///  Notification constants
///

BEACON.notifications = {
    types: {
        INFORMATIONAL: "BEACON.NOTIFICATION.INFORMATIONAL",
        INTRUSIVE: "BEACON.NOTIFICATION.INTRUSIVE",
        BLOCKING: "BEACON.NOTIFICATION.BLOCKING"
    },

    ShownState: {
        SEEN: "BEACON.NOTIFICATION.SEEN",
        UNSEEN: "BEACON.NOTIFICATION.UNSEEN",
        REMOVED: "BEACON.NOTIFICATION.REMOVED"
    }
};


///
///  NotificationObjects - This stores the html that makes the notification objects
///

BEACON.notifications.NotificationObjects = {

    ColourTheme: 'dark',

    NotificationIDPrefix: "notify_",

    Informational: function (notificationObject) {
        var notify_class = "notificationObject " + BEACON.notifications.NotificationObjects.ColourTheme;
        //add the sticky class if the notification is a sticky
        if (notificationObject["Sticky"])
            notify_class += " sticky";
        var notify_InstanceDesignation = notificationObject.InstanceDesignation.trim() !== "" ? notificationObject.InstanceDesignation : "";
        var informationalHtml = '<div id="' + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '" ';
        informationalHtml += 'InstanceDesignation="' + notify_InstanceDesignation + '" ';
        informationalHtml += 'class="' + notify_class + '" >';
        informationalHtml += '<a href="JavaScript:void(null);" title="' + BEACON.Labels.GetLabel("DISMISS_NOTIFICATION_SCASE") + '" onclick="BEACON.notifications.UI.DismissNotification(\'' + notificationObject.NotificationID + '\')" class="notificationClose glyphicons beaconDelete"></a>';

        /* Notification content */
        informationalHtml += '<div class="notificationContent">';
        
        if (notificationObject.DirectLink !== '' && (!isMobile || (isMobile && !notificationObject.DirectLinkNotMobile))){
            informationalHtml += '<a href="JavaScript:void(null);" title="' + BEACON.Labels.GetLabel("VIEW_CONTENT_SCASE") + '" onclick="BEACON.notifications.UI.DismissNotification(\'' + notificationObject.NotificationID + '\',\'' + notificationObject.DirectLink + '\')">';
        }

        informationalHtml += BEACON.notifications.NotificationObjects.Snippet.NotificationImage(notificationObject);

        //Notification Title
        informationalHtml += BEACON.notifications.NotificationObjects.Snippet.TitleText(notificationObject.NotificationTitle);

        if (notificationObject.DirectLink !== '' && (!isMobile || (isMobile && !notificationObject.DirectLinkNotMobile))) {
            informationalHtml += '</a>';
        }

        //Percentage
        if (notificationObject.PercentageTracker === true) {

            //Percentage text
            if (notificationObject.PercentageText.length > 0) {
                informationalHtml += BEACON.notifications.NotificationObjects.Snippet.BodyText(notificationObject.PercentageText);
            }

            //Percentage Value
            informationalHtml += BEACON.notifications.NotificationObjects.Snippet.Percentage(notificationObject.PercentageValue);
        }

        //if want time stamp
        if (notificationObject.PercentageTracker !== true) {
            informationalHtml += BEACON.notifications.NotificationObjects.Snippet.SmallTimeStamp(notificationObject.UpdatedDate);
        }

        //if body text
        if (notificationObject.BodyText.length > 0) {
            informationalHtml += BEACON.notifications.NotificationObjects.Snippet.BodyText(notificationObject.BodyText);
        }

        informationalHtml += '</div>';

        /* End of Notification content */


        informationalHtml += '</div>';

        return informationalHtml;
    },

    Intrusive: function (notificationObject) {

        var intrusiveHtml = '<div id="' + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + ' "';
        intrusiveHtml += 'class="notificationIntrusiveContainer ' + BEACON.notifications.NotificationObjects.ColourTheme + '">';

        /* Notification content */
        intrusiveHtml += '<div class="notificationContent">';

        intrusiveHtml += '<a href="JavaScript:void(null);" title="' + BEACON.Labels.GetLabel("DISMISS_NOTIFICATION_SCASE") + '" onclick="BEACON.notifications.UI.DismissIntrusiveNotification(\'' + notificationObject.NotificationID + '\')" class="notificationClose glyphicons beaconDelete"></a>';

        if (notificationObject.DirectLink !== '' && (!isMobile || (isMobile && !notificationObject.DirectLinkNotMobile))) {
            intrusiveHtml += '<a href="' + notificationObject.DirectLink + '">';
        }

        intrusiveHtml += BEACON.notifications.NotificationObjects.Snippet.NotificationImage(notificationObject);

        //Notification Title
        intrusiveHtml += BEACON.notifications.NotificationObjects.Snippet.TitleText(notificationObject.NotificationTitle);

        if (notificationObject.DirectLink !== '' && (!isMobile || (isMobile && !notificationObject.DirectLinkNotMobile))) {
            intrusiveHtml += '</a>';
        }

        //Percentage
        if (notificationObject.PercentageTracker === true) {

            //Percentage text
            if (notificationObject.PercentageText.length > 0) {
                intrusiveHtml += BEACON.notifications.NotificationObjects.Snippet.BodyText(notificationObject.PercentageText);
            }

            //Percentage Value
            intrusiveHtml += BEACON.notifications.NotificationObjects.Snippet.Percentage(notificationObject.PercentageValue);
        }

        //Time Stamp
        intrusiveHtml += BEACON.notifications.NotificationObjects.Snippet.SmallTimeStamp(notificationObject.UpdatedDate);

        //if body text
        if (notificationObject.BodyText.length > 0) {
            intrusiveHtml += BEACON.notifications.NotificationObjects.Snippet.BodyText(notificationObject.BodyText);
        }

        //Dismiss button
        if (notificationObject.NotificationDismissButtonText.length > 0) {
            var dismissButtonAction = ((notificationObject.NotificationDismissButtonActionOverride.length > 0) ? notificationObject.NotificationDismissButtonActionOverride : "BEACON.notifications.UI.DismissIntrusiveNotification('" + notificationObject.NotificationID + "')");
            intrusiveHtml += BEACON.notifications.NotificationObjects.Snippet.DismissButton(notificationObject.NotificationDismissButtonText, dismissButtonAction);
        }


        intrusiveHtml += '</div>';
        /* End of Notification content */

        intrusiveHtml += '</div>';

        return intrusiveHtml;
    },

    Blocking: function (notificationObject) {

        var blockingHtml = '<div id="' + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + ' "';
        blockingHtml += 'class="notificationBlockingContainer ' + BEACON.notifications.NotificationObjects.ColourTheme + '">';

        /* Notification content */
        blockingHtml += '<div class="notificationContent">';

        if (notificationObject.DirectLink !== '' && (!isMobile || (isMobile && !notificationObject.DirectLinkNotMobile))) {
            blockingHtml += '<a href="' + notificationObject.DirectLink + '">';
        }

        blockingHtml += BEACON.notifications.NotificationObjects.Snippet.NotificationImage(notificationObject);

        //Notification Title
        blockingHtml += BEACON.notifications.NotificationObjects.Snippet.TitleText(notificationObject.NotificationTitle);


        if (notificationObject.DirectLink !== '' && (!isMobile || (isMobile && !notificationObject.DirectLinkNotMobile))) {
            blockingHtml += '</a>';
        }
        //Time Stamp
        blockingHtml += BEACON.notifications.NotificationObjects.Snippet.SmallTimeStamp(notificationObject.UpdatedDate);

        //if body text
        if (notificationObject.BodyText.length > 0) {
            blockingHtml += BEACON.notifications.NotificationObjects.Snippet.BodyText(notificationObject.BodyText);
        }

        //Dismiss button - This is currently the only way to remove a blocking notification - so if a blocking notification exists without any Dismiss button text, you are stuck there. It's just how it works, sorry, blame Canada.
        if (notificationObject.NotificationDismissButtonText.length > 0) {
            var dismissButtonAction = ((notificationObject.NotificationDismissButtonActionOverride.length > 0) ? notificationObject.NotificationDismissButtonActionOverride : "BEACON.notifications.UI.DismissBlockingNotification('" + notificationObject.NotificationID + "')");
            blockingHtml += BEACON.notifications.NotificationObjects.Snippet.DismissButton(notificationObject.NotificationDismissButtonText, dismissButtonAction);
        }

        blockingHtml += '</div>';
        /* End of Notification content */

        blockingHtml += '</div>';

        return blockingHtml;

    },


    ViewAll: function (notificationObject, idPrefix) { //Object that displays all three notification objects in a single object
        var notify_class = "notificationObject ViewAll";

        if (!notificationObject.DbSeen) { notify_class += " unseen" };

        var notify_InstanceDesignation = notificationObject.InstanceDesignation.trim() !== "" ? notificationObject.InstanceDesignation : "";
        if (!idPrefix) idPrefix = "";

        var idPart = idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID
        var turnOff_off_display = "";
        var turnOff_on_display = "";
        var popup_off_display = "";
        var popup_on_display = "";
        var email_off_display = "";
        var email_on_display = "";
        var turnOff_val = "0";
        var popup_val = "0";
        var email_val = "0";

        if (notificationObject.ChannelPrefNone) {
            turnOff_val = "1";
            popup_val = "0";
            email_val = "0";
            turnOff_off_display = " display: none; ";
            turnOff_on_display = " display: inline-block; ";
            popup_off_display = " display: inline-block; ";
            popup_on_display = " display: none; ";
            email_off_display = " display: inline-block; ";
            email_on_display = " display: none; ";
        } else {
            turnOff_off_display = " display: inline-block; ";
            turnOff_on_display = " display: none; ";
            turnOff_val = "0";

            if (!notificationObject.ChannelPrefPopup) {
                popup_off_display = " display: inline-block; ";
                popup_on_display = " display: none; ";
                popup_val = "0";
            } else {
                popup_off_display = " display: none; ";
                popup_on_display = " display: inline-block; ";
                popup_val = "1";
            }

            if (!notificationObject.ChannelPrefEmail) {
                email_off_display = " display: inline-block; ";
                email_on_display = " display: none; ";
                email_val = "0";
            } else {
                email_off_display = " display: none; ";
                email_on_display = " display: inline-block; ";
                email_val = "1";
            }
        }
        var viewAllHtml = '<div id="' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '" ';
        viewAllHtml += 'InstanceDesignation="' + notify_InstanceDesignation + '" ';
        viewAllHtml += 'class="' + notify_class + '" ><div class=\"notificationClose\">';

        if (notificationObject.ChannelString != "") {
            viewAllHtml += '<a href=\"JavaScript:BEACON.notifications.All.toggleChannelPrefsPopDown(\'' + idPart + '\');\" title=\"' + BEACON.Labels.GetLabel('TOGGLE_PREFERENCES_FOR_COLON_SCASE') + ' ' + notificationObject.ChannelGroupString + '\" class=\"glyphicons actionIcon cogwheel rightPad_small\"></a>';

            viewAllHtml += '<div name="notificationPrefsPopdown" id="prefs_' + idPart + '" style=\"display: none;\" class=\"preferencesPopDown topPad_small bottomPad_medium leftPad_small rightPad_small\">';
            viewAllHtml += '<h4>' + BEACON.Labels.GetLabel("PREFERENCES_FOR_NOTIFICATIONS_LIKE_THIS") + ':</h4>';
            viewAllHtml += '<div class=\"topPad_medium bottomPad_medium withSeparator\">';
            viewAllHtml += '<a name=\"turnOff_off_' + notificationObject.ChannelString + '\" ';
            viewAllHtml += 'id=\"turnOff_off_' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\" class=\"inlineBlock glyphicons unchecked actionIcon rightMargin_small\" ';
            viewAllHtml += 'title=\"' + BEACON.Labels.GetLabel("TURN_OFF_NOTIFICATIONS_SCASE") + '\" ';
            viewAllHtml += 'href=\"JavaScript: BEACON.notifications.All.ToggleChannelPref(\'turnOff\', \'on\', \'' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\', \'' + notificationObject.ChannelString + '\'); \" style=\"' + turnOff_off_display + '\">';
            viewAllHtml += '<img src=\"/sorce/sorce_standard_icons/1pxtrans.gif\" alt=\"' + BEACON.Labels.GetLabel('TURN_OFF') + '\"></a>';
            viewAllHtml += '<a name=\"turnOff_on_' + notificationObject.ChannelString + '\" ';
            viewAllHtml += 'id=\"turnOff_on_' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\" class=\"inlineBlock glyphicons check actionIcon rightMargin_small\" ';
            viewAllHtml += 'title=\"' + BEACON.Labels.GetLabel('TURN_ON_NOTIFICATIONS_SCASE') + '\" ';
            viewAllHtml += 'href=\"JavaScript: BEACON.notifications.All.ToggleChannelPref(\'turnOff\', \'off\', \'' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\', \'' + notificationObject.ChannelString + '\'); \" style=\"' + turnOff_on_display + '\">';
            viewAllHtml += '<img src=\"/sorce/sorce_standard_icons/1pxtrans.gif\" alt=\"' + BEACON.Labels.GetLabel("TURN_OFF") + '\"></a>';
            viewAllHtml += '<label>' + BEACON.Labels.GetLabel("TURN_OFF") + '</label>';
            viewAllHtml += '<input name=\"turnOff_value_' + notificationObject.ChannelString + '\" ';
            viewAllHtml += 'id=\"turnOff_value_' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\" type=\"text\" style=\"display:none;\" value=\"' + turnOff_val + '\">';
            viewAllHtml += '</div>';


            var popupOffClass = "inlineBlock glyphicons unchecked actionIcon rightMargin_small";

            if (notificationObject.minimumPopup) {
                popupOffClass = "inlineBlock glyphicons check actionIcon rightMargin_small colourChecked_0";
            }

            viewAllHtml += '<div class=\"topPad_medium\">';
            viewAllHtml += '<a name=\"popup_off_' + notificationObject.ChannelString + '\" ';
            viewAllHtml += 'id=\"popup_off_' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\" class=\"' + popupOffClass + '\" ';
            viewAllHtml += 'title=\"' + BEACON.Labels.GetLabel("TURN_ON_POP_UP_NOTIFICATIONS_SCASE") + '\" ';
            viewAllHtml += 'href=\"JavaScript: BEACON.notifications.All.ToggleChannelPref(\'popup\', \'on\', \'' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\', \'' + notificationObject.ChannelString + '\'); \" style=\"' + popup_off_display + '\">';
            viewAllHtml += '<img src=\"/sorce/sorce_standard_icons/1pxtrans.gif\" alt=\"' + BEACON.Labels.GetLabel("POPUP") + '\"></a>';
            viewAllHtml += '<a name=\"popup_on_' + notificationObject.ChannelString + '\" ';
            viewAllHtml += 'id=\"popup_on_' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\" class=\"inlineBlock glyphicons check actionIcon rightMargin_small\" ';
            viewAllHtml += 'title=\"' + BEACON.Labels.GetLabel("TURN_OFF_POP_UP_NOTIFICATIONS_SCASE") + '\" ';
            viewAllHtml += 'href=\"JavaScript: BEACON.notifications.All.ToggleChannelPref(\'popup\', \'off\', \'' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\', \'' + notificationObject.ChannelString + '\'); \" style=\"' + popup_on_display + '\">';
            viewAllHtml += '<img src=\"/sorce/sorce_standard_icons/1pxtrans.gif\" alt=\"' + BEACON.Labels.GetLabel("POPUP") + '\"></a>';
            viewAllHtml += '<label>' + BEACON.Labels.GetLabel("POPUP") + '</label>';
            viewAllHtml += '<input name=\"popup_value_' + notificationObject.ChannelString + '\" ';
            viewAllHtml += 'id=\"popup_value_' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\" type=\"text\" style=\"display:none;\" value=\"' + popup_val + '\">';
            viewAllHtml += '</div>';

            var emailOffClass = "inlineBlock glyphicons unchecked actionIcon rightMargin_small"

            if (notificationObject.minimumEmail) {
                emailOffClass = "inlineBlock glyphicons check actionIcon rightMargin_small colourChecked_0";
            }

            viewAllHtml += '<div class=\"topPad_medium\">';
            viewAllHtml += '<a name=\"email_off_' + notificationObject.ChannelString + '\" ';
            viewAllHtml += 'id=\"email_off_' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\" class=\"' + emailOffClass + '\" ';
            viewAllHtml += 'title=\"' + BEACON.Labels.GetLabel('TURN_ON_EMAIL_NOTIFICATIONS_SCASE') + '\" ';
            viewAllHtml += 'href=\"JavaScript: BEACON.notifications.All.ToggleChannelPref(\'email\', \'on\', \'' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\', \'' + notificationObject.ChannelString + '\'); \" style=\"' + email_off_display + '\">';
            viewAllHtml += '<img src=\"/sorce/sorce_standard_icons/1pxtrans.gif\" alt=\"' + BEACON.Labels.GetLabel("EMAIL") + '\"></a>';
            viewAllHtml += '<a name=\"email_on_' + notificationObject.ChannelString + '\" ';
            viewAllHtml += 'id=\"email_on_' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\" class=\"inlineBlock glyphicons check actionIcon rightMargin_small\" ';
            viewAllHtml += 'title=\"' + BEACON.Labels.GetLabel("TURN_OFF_EMAIL_NOTIFICATIONS_SCASE") + '\" ';
            viewAllHtml += 'href=\"JavaScript: BEACON.notifications.All.ToggleChannelPref(\'email\', \'off\', \'' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\', \'' + notificationObject.ChannelString + '\'); \" style=\"' + email_on_display + '\">';
            viewAllHtml += '<img src=\"/sorce/sorce_standard_icons/1pxtrans.gif\" alt=\"' + BEACON.Labels.GetLabel("EMAIL") + '\"></a>';
            viewAllHtml += '<label>' + BEACON.Labels.GetLabel("EMAIL") + '</label>';
            viewAllHtml += '<input name=\"email_value_' + notificationObject.ChannelString + '\" ';
            viewAllHtml += 'id=\"email_value_' + idPrefix + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID + '\" type=\"text\" style=\"display:none;\" value=\"' + email_val + '\">';
            viewAllHtml += '</div>';

            viewAllHtml += '</div>';
            viewAllHtml += '<div name="notificationPrefsPopdown" id="prefs_' + idPart + '_disabled" style=\"display: none;\" class=\"preferencesPopDown preferencesPopDownWide topPad_medium bottomPad_medium leftPad_medium rightPad_medium\">';
            viewAllHtml += '<h4>' + document.getElementsByName("notificationViewAllLabel_ALLOW_NOTIFICATIONS_CONFIGURED_INDIVIDUALLY")[0].innerText + '</h4>';
            viewAllHtml += '</div>';
        }

        viewAllHtml += '<a href="JavaScript:void(null);" title=\"' + BEACON.Labels.GetLabel('DELETE_NOTIFICATION_SCASE') + '\" onclick="BEACON.notifications.UI.DismissNotificationFromViewAll(\'' + notificationObject.NotificationID + '\')" class="glyphicons beaconDelete"></a></div>';


        /* Notification content */

        viewAllHtml += '<div class="notificationContent">';

        if (notificationObject.DirectLink !== '' && (!isMobile || (isMobile && !notificationObject.DirectLinkNotMobile))) {
            viewAllHtml += '<a href="' + notificationObject.DirectLink + '" title="' + BEACON.Labels.GetLabel("VIEW_CONTENT_SCASE") + '">';
        }

        viewAllHtml += BEACON.notifications.NotificationObjects.Snippet.NotificationImage(notificationObject);

        //Notification Title
        viewAllHtml += "</span>" + BEACON.notifications.NotificationObjects.Snippet.TitleText(notificationObject.NotificationTitle);

        if (notificationObject.DirectLink !== '' && (!isMobile || (isMobile && !notificationObject.DirectLinkNotMobile))) {
            viewAllHtml += '</a>';
        }

        //Percentage
        if (notificationObject.PercentageTracker === true) {

            //Percentage text
            if (notificationObject.PercentageText.length > 0) {
                viewAllHtml += BEACON.notifications.NotificationObjects.Snippet.BodyText(notificationObject.PercentageText);
            }

            //Percentage Value
            viewAllHtml += BEACON.notifications.NotificationObjects.Snippet.Percentage(notificationObject.PercentageValue);
        }

        //Time stamp - exclude for percentage notifications
        if (notificationObject.PercentageTracker !== true) {
            viewAllHtml += BEACON.notifications.NotificationObjects.Snippet.SmallTimeStamp(notificationObject.UpdatedDate);
        }

        //Body Text
        if (notificationObject.BodyText.length > 0) {
            viewAllHtml += BEACON.notifications.NotificationObjects.Snippet.BodyText(notificationObject.BodyText);
        }

        //Dismiss button
        if (notificationObject.NotificationDismissButtonText.length > 0) {
            if (notificationObject.NotificationDismissButtonActionOverride.length > 0)
                var dismissButtonAction = ((notificationObject.NotificationDismissButtonActionOverride.length > 0) ? notificationObject.NotificationDismissButtonActionOverride : "BEACON.notifications.UI.DismissNotification('" + notificationObject.NotificationID + "')");
            viewAllHtml += BEACON.notifications.NotificationObjects.Snippet.DismissButton(notificationObject.NotificationDismissButtonText, dismissButtonAction);
        }

        viewAllHtml += '</div>';

        /* End of Notification content */

        viewAllHtml += '</div>';

        return viewAllHtml;
    },


};

BEACON.notifications.NotificationObjects.Snippet = {

    NotificationImage: function (notificationObject) {

        if (notificationObject.NotificationIcon.length > 0) {
            return "<span class=\"" + notificationObject.NotificationIcon + "\"/> </span>";
        }
        else {
            if (notificationObject.NotificationImage.length > 0) {
                return "<img src=\"" + notificationObject.NotificationImage + "\" width=\"40\" height=\"40\"/>";
            }
            else {
                return "";
            }
        }
    },

    TitleText: function (notificationTitleText) {
        return '<h4>' + notificationTitleText + '</h4>';
    },

    BodyText: function (notificationBodyText) {
        return "<p>" + notificationBodyText + "</p>";
    },

    SmallTimeStamp: function (notificationTime) { //moment.js is used to figure this out

        //figure out the time to put below
        return "<p class=\"contentAuthorDate\">" + notificationTime + "</p>"
    },

    Percentage: function (notificationPercentage) {
        var percentageHtml = "<div class=\"notificationsPercentageHolder\">";
        percentageHtml += "<div class=\"notificationsPercentageBar\"><div class=\"notificationsPercentageBarFill\" style=\"width:" + notificationPercentage + "%;\"></div></div>";
        percentageHtml += "<div class=\"notificationPercentageText\">" + notificationPercentage + "%</div>";
        percentageHtml += "</div>";
        return percentageHtml;
    },

    DismissButton: function (notificationDismissButtonText, dismissButtonClick) {
        return "<button type=\"button\" class=\"dismissButton\" onclick=\"" + dismissButtonClick + "\">" + notificationDismissButtonText + "</button>";
    }



};

///
///  Notifications - Javascript object that represents a notification
///

BEACON.notifications.notification = function (notificationID, notificationType) {

    this.NotificationID = notificationID;
    this.Type = notificationType;


    this.Stored = '';
    this.Sticky = '';
    this.DbSeen = '';
    this.InstanceDesignation = '';

    this.NotificationTitle = '';
    this.NotificationIcon = '';
    this.NotificationImage = '';
    this.DirectLink = '';
    this.DirectLinkNotMobile = false;

    this.BodyText = '';
    this.ActionName = '';
    this.ActionText = '';
    this.ActionType = '';
    this.PlaceholderText = '';

    this.PercentageTracker = false;
    this.PercentageText = '';
    this.PercentageValue = '';

    this.NotificationDismissButtonText = '';
    this.NotificationDismissButtonActionOverride = '';

    this.UpdatedDate = '';

    this.FadeOut = 0;

    this.ChannelString = '';
    this.ChannelGroupString = '';

    this.ChannelPrefPopup = false;
    this.ChannelPrefEmail = false;
    this.ChannelPrefNone = false;

    this.minimumEmail = false;
    this.minimumPopup = false;

    this.StandardSortOrder = 0;

    this.StopFadeOut = function () {
        if (this.FadeOut) {
            clearTimeout(this.FadeOut);
            this.FadeOut = 0;
        }
    }
}

///
///  Notification Glare
///

BEACON.notifications.Glare = {

    Container: ".notificationsGlareContainer",

    HTML: function () {
        return '<div class="notificationsGlareContainer"></div>';
    },

    RightMove: function (rightPosition) {
        $(this.Container).right(rightPosition + 'px');
    },

    RightAnimate: function (rightPosition) {
        $(this.Container).animate({ 'right': rightPosition + 'px' });
    },

    AnimateToOriginalPosition: function () {
        this.RightAnimate('20');
    },

    MoveNextToShade: function () {
        this.RightAnimate('350');
    },

    Clear: function (ClearSticky) {
        if (ClearSticky)
            $(this.Container).html('');
        else/*Only remove content of glare that is not sticky*/
            $(this.Container + ' > *').not('.sticky').remove();
    },

    Add: function (objectHTML) {
        var NotificationHTMLObject = $(objectHTML);
        $(this.Container).append(NotificationHTMLObject);
        NotificationHTMLObject.hide().fadeIn(BEACON.notifications.UI.NOTIFICATION_FADEIN);
    }
};

///
///  Notification Shade
///

BEACON.notifications.Shade = {
    Content: ".notificationsShadeContent",
    Container: ".notificationsShadeContainer",
    NotificationsCurrentlyInShade: new Array(),
    shadeNotifications: 0,
    Active: false,

    HTML: function () {
        return '<div class="notificationsShadeContainer"><div class="notificationsShadeHeader">' + BEACON.Labels.GetLabel("NOTIFICATIONS") + '<a href="JavaScript:void(null)" title="' + BEACON.Labels.GetLabel("TOGGLE_NOTIFICATION_SOUNDS_SCASE") + '" id="notificationsMuteToggle" onclick="BEACON.notifications.UI.toggleMute()" class="glyphicons volume-up floatRight"></a></div><div id="nonotifications">' + BEACON.Labels.GetLabel("THERE_ARE_CURRENTLY_NO_ACTIVE_NOTIFICATIONS_SCASE") + '</div><div class="notificationsShadeContent"></div><div class="notificationsShadeFooter"><a href="/sorce/beacon/default.aspx?pageid=notifications" title="' + BEACON.Labels.GetLabel("GO_TO_THE_NOTIFICATIONS_PAGE_SCASE") + '">' + BEACON.Labels.GetLabel("VIEW_ALL_SCASE") + '</a></div></div>';
    },

    Open: function () {
        BEACON.notifications.Shade.Active = true;
        $(this.Container).slideDown();
    },

    Close: function () {
        $(this.Container).slideUp(function () { BEACON.notifications.Shade.Active = false; });
    },


    Clear: function () {
        $(this.Content).html('');
        BEACON.notifications.Shade.NotificationsCurrentlyInShade = new Array();
    },


    Add: function (notificationID, objectHTML, sticky) {//Add the notification html to the shade

        if (sticky === true) { // Move to the top of the list
            var notificationObject = $(objectHTML);
            notificationObject.addClass("sticky");
            $(BEACON.notifications.Shade.Content).prepend(notificationObject);
        } else {
            $(this.Content).append(objectHTML);
        }

        // Add the notification to the list of notifications in the shade
        BEACON.notifications.Shade.NotificationsCurrentlyInShade.push(notificationID);
    },

    ShowNoActiveNotifications: function () {
        $("#nonotifications").show();
    },

    HideNoActiveNotifications: function () {
        $("#nonotifications").hide();
    }

};


///
///  CORE
///

BEACON.notifications.CORE = {
    initialized: false,
    NotificationsArray: new Array(), //This object will store ALL notifications 
    GetNotificationsIDs: function () { //Return an array of notifications IDs
        var rtnIDArray = new Array();
        $.each(BEACON.notifications.CORE.NotificationsArray, function (index, notification) { rtnIDArray.push(notification.NotificationID); });
        return rtnIDArray;
    },
    NotificationsLooper: false,
    NotificationsLooperInterval: 5000,  //every 5 seconds
    ClientNotificationGuid: "00000000-0000-0000-0000-000000000000",
    SessionStoragePrefix: "BeaconNotification_",
    MaximumNumberOfNotificationsToDisplayAtOneTime: 5,
    NotificationsSeenTimeout: 3000, //Notifications are set to been seen after having been displayed for 3 seconds.
    ActiveIntrusiveNotification: false,
    ActiveBlockingNotification: false,
    ViewAllPageActive: false,
    ImportSorceAlertsTimer: false,
    ImportSorceAlertsTimerInterval: 60000, //every 60 seconds, run the import sorce alerts
    InitialLoad: true,

    //createDebugBoxDiv: function(){                  
    //    //DEBUG code
    //    $('#mainContainer').prepend("<div id='debugbox'>Debug Box</div>");

    //    setInterval(function () {
    //        var heighttoshow = $('.notificationsGlareContainer').height();
    //        $('#debugbox').html("height= " + heighttoshow);
    //    }, 10);
    //},

    startup: function () {
        BEACON.notifications.CORE.Remove.ClearOutdatedStatesFromMemory();
        BEACON.GetLabelTextFromServer(MLLabels, function (LabelData) {
            BEACON.Labels.AddLabelsToCache(LabelData);

            BEACON.notifications.UI.SetNotificationsCount(0);

            // Check local storage is available, if not do not start the notificataions system and report to user.
            if (typeof (Storage) !== "undefined") {

                // Start the UI objects
                BEACON.notifications.UI.Startup();

                // Startup complete.
                if (BEACON.notifications.UI.initialized === true) {

                    BEACON.notifications.CORE.initialized = true;

                    // Get the inital notifications
                    // Update any previous informational or intrusive notifications to having been seen - on return get latest notifications -- only do this once per session
                    if (BEACON.notifications.CORE.HasPreviousNotificationsProcessed() === false) {
                        var PostData = "r=3";
                        BEACON.xhrPost("notifications.aspx", PostData, function (rtnObj) {
                            BEACON.notifications.CORE.SetPreviousNotificationsProcessed();
                            BEACON.notifications.CORE.RetrieveNotifications();
                        });
                    }
                    else {
                        BEACON.notifications.CORE.RetrieveNotifications();
                    }

                    // Every X seconds run code to import sorce alerts = this could be done in a back end process that might be more resource friendly.
                    ImportSorceAlertsTimer = setInterval(function () { BEACON.notifications.CORE.ImportSorceAlerts(); }, BEACON.notifications.CORE.ImportSorceAlertsTimerInterval);

                    // DEBUG code - creates a button to click on which launches the notification demo
                    //$('#mainContainer').prepend("<div style=\"width:100px; height: 50px; border: solid 1px black; background-color: white;\" onclick=\"notification('I am an alert')\">Click Me</div>");
                    $(document).trigger("BEACON:PAGE:notificationsReady");
                }
                else {
                    // UI failed to initialise, cannot proceed.
                }
            }
            else {
                alert("Sorry, your browser does not support web storage. This is required for notifications."); //Don't evade, upgrade!
            }
        });
    },

    CreateNotificationsTimeout: function () {
        // By calling a timeout after each method has been processed, the NotificationsLooperInterval variable can be updated and directly reflected by the system.
        BEACON.notifications.CORE.NotificationsLooper = setTimeout(function () { BEACON.notifications.CORE.RetrieveNotifications(); }, BEACON.notifications.CORE.NotificationsLooperInterval);
    },

    RetrieveNotifications: function () {
        // Get notifications - AJAX and call back to process Notifications
        var PostData = "ClientNotificationGuid=" + encodeURIComponent(BEACON.notifications.CORE.ClientNotificationGuid);
        BEACON.xhrPost("notifications.aspx?", PostData, BEACON.notifications.CORE.ProcessIncomingNotificationData);
    },

    ImportSorceAlerts: function () {
        var PostData = "r=5";
        BEACON.xhrPost("notifications.aspx?", PostData);
    },

    setVisibleCount: function () {
        var visibleCount = 0;
        for (var i = 0; i < BEACON.notifications.CORE.NotificationsArray.length; i++) {
            iNotification = BEACON.notifications.CORE.NotificationsArray[i];
            if (iNotification.Stored) {
                visibleCount += 1;
            }
        }

        //if (!isMobile) {visibleCount = parseInt(visibleCount) + parseInt(BEACON.alerts.numberOfSORCEAlerts);}

        BEACON.notifications.UI.SetNotificationsCount(visibleCount);
    },


    ToggleNotificationShade: function () {
        if (BEACON.notifications.Shade.Active === false) //Open notifications shade
        {
            //Hides all NavBarDropDown's
            if ($(".Nav_SubUL:visible").length) {
                var navBarElement = document.querySelector("div.DesktopPrimaryNav.desktopOnly > nav > ul");
                $(navBarElement).find('li').find('.Nav_ItemWrapper').removeClass("lihover");
            }

            // Hide CogDropDown container.
            if ($(".beaconToolbarAddContentUL:visible").length) {
                var toolBar_cogA = document.getElementById("BEACON_Toolbar_Cog_Toggle_A");
                toolBar_cogA.setAttribute("title", toolBar_cogA.getAttribute("showtitle"));
                $(".beaconToolbarAddContentUL").slideToggle();
            }

            //Hide Office 365 Notification container.
            BEACON.CloseOffice365Shade();
            
            var toolBar_notificationA = document.getElementById("BEACON_Toolbar_Alerts_Toggle_A");
            toolBar_notificationA.setAttribute("title", toolBar_notificationA.getAttribute("hidetitle"));

            //Clear the shade and the Glare of contents - opening the shade will clear anything in the Glare
            BEACON.notifications.Shade.Clear();
            BEACON.notifications.Glare.Clear();

            //Load inital notifications into the shade
            $.each(BEACON.notifications.CORE.NotificationsArray, function (index, notification) {
                switch (notification.Type) {
                    case BEACON.notifications.types.INFORMATIONAL:
                        if (notification.Stored === true) {
                            BEACON.notifications.CORE.DisplayNotificationInShade(notification)
                        }
                        break;
                    case BEACON.notifications.types.INTRUSIVE:
                        break;
                    case BEACON.notifications.types.BLOCKING:
                        break;
                }
            });

            BEACON.notifications.Glare.MoveNextToShade();
            BEACON.notifications.Shade.Open(); //Load notifications into the shade and open
        }
        else //Close notifications shade
        {
            var toolBar_notificationA = document.getElementById("BEACON_Toolbar_Alerts_Toggle_A");
            toolBar_notificationA.setAttribute("title", toolBar_notificationA.getAttribute("showtitle"));

            BEACON.notifications.Glare.AnimateToOriginalPosition();
            BEACON.notifications.Shade.Close();
            BEACON.notifications.Shade.Clear();
        }
    },

    ProcessIncomingNotificationData: function (notificationJSON) {

        //Send any JSON to be processed
        BEACON.notifications.UI.UpdateNotificationsWithNewData = BEACON.notifications.CORE.ProcessNotificationJSON(notificationJSON);

        //Display notifications that are in the local array
        BEACON.notifications.CORE.DisplayNotifications();


        //Setup the timout for the next loop to retreve notifications
        BEACON.notifications.CORE.CreateNotificationsTimeout();

        BEACON.notifications.CORE.setVisibleCount();


        for (var i = 0; i < localStorage.length; i++) {
            var thisKey = localStorage.key(i);
            var thisValue = localStorage.getItem(thisKey);

            if (thisKey.indexOf(BEACON.notifications.CORE.SessionStoragePrefix) == 0) {
                if ($.inArray(thisValue.split(",")[0], BEACON.notifications.CORE.GetNotificationsIDs()) === -1) { //Check to see if the notification already exists in the system - Add the notification into the system arrays
                    localStorage.removeItem(BEACON.notifications.CORE.SessionStoragePrefix + thisValue.split(",")[0]);
                    i--;
                }
            }
        }

    },

    ProcessNotificationJSON: function (notificationJSON) {

        var UpdateNotificationsWithNewData = false;

        //Check to see if there is any new data - If the client GUID doesn't match the application GUID, there is new Data in the JSON
        if (BEACON.notifications.CORE.ClientNotificationGuid != notificationJSON.ClientNotificationGuid) {
            BEACON.notifications.CORE.ClientNotificationGuid = notificationJSON.ClientNotificationGuid;
            UpdateNotificationsWithNewData = true;

            //Process each notification - update and insert data into memory
            if (typeof (notificationJSON.Notifications) != "undefined") {
                $.each(notificationJSON.Notifications, function (index, value) {
                    BEACON.notifications.CORE.InjectNotification(BEACON.notifications.CORE.ProcessNotification(value));
                });
                BEACON.notifications.CORE.InitialLoad = false
            }
        }

        return UpdateNotificationsWithNewData;
    },

    ProcessNotification: function (inNotification) { //This method can be called independently to insert notifications into the the system

        var objNotification = new BEACON.notifications.notification(inNotification.NotificationID, BEACON.notifications.CORE.UpdateNotificationType(inNotification));

        //We only update where there is data - the creation of the notification object sets properties to empty strings, which is used with a jQuery .length method - this method errors if it is run on an undefined object.
        if (typeof (inNotification.Stored) != "undefined") { objNotification.Stored = inNotification.Stored; };
        if (typeof (inNotification.Sticky) != "undefined") { objNotification.Sticky = inNotification.Sticky; };
        if (typeof (inNotification.DbSeen) != "undefined") { objNotification.DbSeen = inNotification.DbSeen; };

        if (typeof (inNotification.InstanceDesignation) != "undefined") { objNotification.InstanceDesignation = inNotification.InstanceDesignation; };

        if (typeof (inNotification.NotificationTitle) != "undefined") { objNotification.NotificationTitle = inNotification.NotificationTitle; };
        if (typeof (inNotification.NotificationIcon) != "undefined") { objNotification.NotificationIcon = inNotification.NotificationIcon; };
        if (typeof (inNotification.NotificationImage) != "undefined") { objNotification.NotificationImage = inNotification.NotificationImage; };
        if (typeof (inNotification.NotificationDirectLink) != "undefined") { objNotification.DirectLink = inNotification.NotificationDirectLink; };
        if (typeof (inNotification.NotificationDirectLinkNotMobile) != "undefined") { objNotification.DirectLinkNotMobile = inNotification.NotificationDirectLinkNotMobile; };

        if (typeof (inNotification.BodyText) != "undefined") { objNotification.BodyText = inNotification.BodyText; };

        if (typeof (inNotification.ActionName) != "undefined") { objNotification.ActionName = inNotification.ActionName; };
        if (typeof (inNotification.ActionText) != "undefined") { objNotification.ActionText = inNotification.ActionText; };
        if (typeof (inNotification.ActionType) != "undefined") { objNotification.ActionType = inNotification.ActionType; };
        if (typeof (inNotification.PlaceholderText) != "undefined") { objNotification.PlaceholderText = inNotification.PlaceholderText; };

        if (typeof (inNotification.PercentageTracker) != "undefined") { objNotification.PercentageTracker = inNotification.PercentageTracker; };
        if (typeof (inNotification.PercentageText) != "undefined") { objNotification.PercentageText = inNotification.PercentageText; };
        if (typeof (inNotification.PercentageValue) != "undefined") { objNotification.PercentageValue = inNotification.PercentageValue; };

        if (typeof (inNotification.ChannelPrefPopup) != "undefined") { objNotification.ChannelPrefPopup = inNotification.ChannelPrefPopup; };
        if (typeof (inNotification.ChannelPrefEmail) != "undefined") { objNotification.ChannelPrefEmail = inNotification.ChannelPrefEmail; };
        if (typeof (inNotification.ChannelPrefNone) != "undefined") { objNotification.ChannelPrefNone = inNotification.ChannelPrefNone; };
        if (typeof (inNotification.ChannelString) != "undefined") { objNotification.ChannelString = inNotification.ChannelString; };
        if (typeof (inNotification.ChannelGroupString) != "undefined") { objNotification.ChannelGroupString = inNotification.ChannelGroupString; };

        if (typeof (inNotification.minimumEmail) != "undefined") { objNotification.minimumEmail = inNotification.minimumEmail; };
        if (typeof (inNotification.minimumPopup) != "undefined") { objNotification.minimumPopup = inNotification.minimumPopup; };

        if (typeof (inNotification.StandardSortOrder) != "undefined") { objNotification.StandardSortOrder = inNotification.StandardSortOrder; };


        //use moment to figure out time
        if (typeof (inNotification.UpdatedDate) != "undefined" && inNotification.UpdatedDate != "") {

            //var inDate = moment.utc(inNotification.UpdatedDate);
            //var localUTC = moment.utc();
            //objNotification.UpdatedDate = moment(inDate).from(localUTC);

            var div = document.createElement('div');
            div.innerHTML = inNotification.UpdatedDate;

            var elemToLocalise = div.firstChild;

            var dateToLocalise = new Date(elemToLocalise.innerHTML);
            var momentToLocalise = moment(elemToLocalise.innerHTML);

            var localDate = dateToLocalise.toLocaleString();
            var localiseMode = elemToLocalise.getAttribute("localiseMode");

            var TZstring = elemToLocalise.parentElement.getAttribute("TZ")

            if (!TZstring) {
                if (localiseMode == "fromNow") {
                    var localMoment = momentToLocalise.fromNow();
                }
                else {
                    if (navigator.language) { momentToLocalise.locale(navigator.language); } else if (navigator.browserLanguage) { momentToLocalise.locale(navigator.browserLanguage); }
                    var localMoment = momentToLocalise.format(localiseMode);
                }
            }
            else {
                /*momentToLocalise = moment();*/
                if (navigator.language) { momentToLocalise.locale(navigator.language); } else if (navigator.browserLanguage) { momentToLocalise.locale(navigator.browserLanguage); }
                var localMoment = momentToLocalise.tz(TZstring).format(localiseMode);
            }
            objNotification.UpdatedDate = localMoment;

        };



        if (typeof (inNotification.NotificationDismissButtonText) != "undefined") { objNotification.NotificationDismissButtonText = inNotification.NotificationDismissButtonText; };
        if (typeof (inNotification.NotificationDismissButtonActionOverride) != "undefined") { objNotification.NotificationDismissButtonActionOverride = inNotification.NotificationDismissButtonActionOverride; };

        return objNotification;
    },

    InjectNotification: function (notificationObject) {
        //Add or update notification data into the system
        if ($.inArray(notificationObject.NotificationID, BEACON.notifications.CORE.GetNotificationsIDs()) === -1) { //Check to see if the notification already exists in the system - Add the notification into the system arrays
            if (BEACON.notifications.CORE.InitialLoad === true) {
                BEACON.notifications.CORE.NotificationsArray.push(notificationObject); //Add the notification
            } else {
                BEACON.notifications.CORE.NotificationsArray.unshift(notificationObject); //Add the notification
            }
        }
        else //Notification is already in the system, update
        {
            BEACON.notifications.CORE.UpdateNotificationsData(notificationObject);
        }
    },

    UpdateNotificationType: function (notification) { //Convert NotificationType from int to type
        var rtnType;
        switch (notification.Type) {
            case 0:
                rtnType = BEACON.notifications.types.INFORMATIONAL;
                break;
            case 1:
                rtnType = BEACON.notifications.types.INTRUSIVE;
                break;
            case 2:
                rtnType = BEACON.notifications.types.BLOCKING;
                break;
        }
        return rtnType;
    },

    UpdateNotificationsData: function (notification) {
        //loop through array and find the notification
        for (var i = 0, len = BEACON.notifications.CORE.NotificationsArray.length; i < len; i++) {
            if (BEACON.notifications.CORE.NotificationsArray[i].NotificationID === notification.NotificationID)
                BEACON.notifications.CORE.NotificationsArray[i] = notification; //update the notification in the array
        }
    },

    DisplayNotifications: function () {
        if (BEACON.notifications.CORE.ActiveBlockingNotification === false || BEACON.notifications.CORE.ActiveIntrusiveNotification === false) { //Only process if there is no blocking or intrusive notification showing - this overrides everything

            var totalNew = 0;
            var skipToShade = false;

            $.each(BEACON.notifications.CORE.NotificationsArray, function (index, value) {
                if ((!BEACON.notifications.CORE.HasNotificationBeenShown(value.NotificationID)) && (value.Stored === true)) totalNew++;
            });

            skipToShade = totalNew >= 10;

            //Loop through notifications array and display the notifications
            $.each(BEACON.notifications.CORE.NotificationsArray, function (index, value) {
                if (BEACON.notifications.UI.DoesNotificationAlreadyExist(value) === true) {
                    BEACON.notifications.UI.UpdateNotificationInPage(value);
                }
                else {
                    BEACON.notifications.CORE.DisplayNotification(value, skipToShade);
                }
            });

            if (skipToShade) {
                var uniqueID = Math.floor((Math.random() * 10000000) + 1)
                var objNotification = new BEACON.notifications.notification(uniqueID, BEACON.notifications.types.INFORMATIONAL);

                objNotification.Stored = false;
                objNotification.Sticky = false;
                objNotification.DbSeen = true;

                objNotification.NotificationTitle = "Notifications";
                objNotification.NotificationIcon = "manyNotifications contentIcon glyphicons bell iconSize_large bottomMargin_large topMargin_small";
                objNotification.NotificationImage = "";
                objNotification.DirectLink = "/sorce/beacon/page/notifications";
                objNotification.DirectLinkNotMobile = false;

                if (BEACON.Constants.lotsOfNotificationsLabel && BEACON.Constants.lotsOfNotificationsLabel != "") {
                    objNotification.BodyText = BEACON.Constants.lotsOfNotificationsLabel;
                }
                else {
                    objNotification.BodyText = BEACON.Labels.GetLabel('YOU_HAVE_A_LOT_OF_NEW_NOTIFICATIONS_EMARK_SCASE');
                }

                objNotification.ActionName = "";
                objNotification.ActionText = "";
                objNotification.ActionType = "";
                objNotification.PlaceholderText = "";

                //BEACON.notifications.CORE.NotificationsArray.push(objNotification);
                CreateNotificationFromObject(objNotification)
            }

        }
    },

    DisplayNotificationInShade: function (notification) {
        if (BEACON.notifications.UI.ContainerHasAvailableSpace(BEACON.notifications.Shade.Container) === true //Make sure there is room to display the notification in the shade
            && $.inArray(notification.NotificationID, BEACON.notifications.Shade.NotificationsCurrentlyInShade) === -1) { //and the notification does not already appear in the shade
            BEACON.notifications.UI.DisplayNotificationInShade(notification);
            BEACON.notifications.Shade.HideNoActiveNotifications();
        }
    },

    UpdateNotification: function (notification) {

        if (BEACON.notifications.CORE.ActiveBlockingNotification === false) { //Only process if there is no blocking notification showing - this overrides everything
            // BEACON.notifications.types.BLOCKING as these are not updated, as we do not process when a blocking is showing
            switch (notification.Type) {
                case BEACON.notifications.types.INFORMATIONAL:

                    break;

                case BEACON.notifications.types.INTRUSIVE:

                    break;

            }//End of switch

        }//End of if (BEACON.notifications.CORE.ActiveBlockingNotification === false)
    },

    DisplayNotification: function (notification, skipToShade) {

        switch (notification.Type) {
            case BEACON.notifications.types.INFORMATIONAL:

                //If the shade is active and the notification is a stored notification, then show in the shade
                if ((BEACON.notifications.Shade.Active === true || skipToShade) && notification.Stored === true) {
                    BEACON.notifications.CORE.DisplayNotificationInShade(notification);
                    BEACON.notifications.CORE.SetNotificationShown(notification.NotificationID)
                }
                else // else show in the glare
                {
                    //if (BEACON.notifications.CORE.ViewAllPageActive === false) { //Only show informational notifications in the Glare if we are not on the view all notifications page
                    if (BEACON.notifications.UI.ContainerHasAvailableSpace(BEACON.notifications.Glare.Container) === true
                        && BEACON.notifications.CORE.HasNotificationBeenShown(notification.NotificationID) === false) { //Check there is room in the container before doing anything else - also see if the notification has already been shown
                        if (notification.Type === BEACON.notifications.types.INFORMATIONAL) { //Only send a notification if there is room in the container and it is of type INFORMATIONAL

                            BEACON.notifications.UI.DisplayNotificationInGlare(notification);

                            //Set the notification to having been seen a second.
                            if (notification.Sticky === false)
                                setTimeout(function () {
                                    if (BEACON.notifications.CORE.ActiveBlockingNotification !== true || BEACON.notifications.CORE.ActiveIntrusiveNotification !== true) //Only set to have been seen if there is not an active blocking or intrusive notification
                                        BEACON.notifications.CORE.SetNotificationShown(notification.NotificationID);
                                }, BEACON.notifications.CORE.NotificationsSeenTimeout);
                        }
                    }
                    //}
                }
                break;

            case BEACON.notifications.types.INTRUSIVE:

                //Make sure the notification has not already been shown and there is no intrusive notification currently showing
                if (BEACON.notifications.CORE.HasNotificationBeenShown(notification.NotificationID) === false && BEACON.notifications.CORE.ActiveIntrusiveNotification === false) {
                    BEACON.notifications.CORE.ActiveIntrusiveNotification = true;
                    BEACON.notifications.UI.DisplayInstrusiveNotification(notification);
                    BEACON.notifications.CORE.SetNotificationShown(notification.NotificationID);
                }

                break;

            case BEACON.notifications.types.BLOCKING:

                //Make sure the notification has not already been shown and there is no intrusive notification currently showing
                if (BEACON.notifications.CORE.ActiveBlockingNotification === false &&
                    BEACON.notifications.CORE.HasBlockingNotificationBeenShown(notification.NotificationID) == false &&
                    BEACON.notifications.CORE.HasNotificationBeenShown(notification.NotificationID) === false) {

                    BEACON.notifications.CORE.ActiveBlockingNotification = true;
                    BEACON.notifications.UI.DisplayBlockingNotification(notification);

                    //Set the system to only show 1 blocking notification per user session
                    BEACON.notifications.CORE.SetBlockingNotificationShown(notification.NotificationID);
                }


                break;

        }//End of switch

    },

    SetNotificationShown: function (NotificationID) {
        localStorage.setItem(BEACON.notifications.CORE.SessionStoragePrefix + NotificationID, NotificationID + "," + BEACON.notifications.ShownState.SEEN);
    },

    SetNotificationUnseen: function (NotificationID) {
        localStorage.setItem(BEACON.notifications.CORE.SessionStoragePrefix + NotificationID, NotificationID + "," + BEACON.notifications.ShownState.UNSEEN);
    },

    SetNotificationRemoved: function (NotificationID) {
        const expiryTime = new Date();
        expiryTime.setTime(expiryTime.getTime() + 3600000) // Add an hour to current time.

        localStorage.setItem("NotificationRemoved_" + NotificationID, NotificationID + "," + BEACON.notifications.ShownState.REMOVED + "," + expiryTime);
    },

    HasNotificationBeenShown: function (NotificationID) {
        var bbe = localStorage.getItem(BEACON.notifications.CORE.SessionStoragePrefix + NotificationID)
        if (bbe) {
            bbe = bbe.split(",")[1] === BEACON.notifications.ShownState.SEEN ? true : false;
        } else {
            bbe = false;
        }

        return bbe;
    },

    HasNotificationBeenRemoved: function (NotificationID) {
        var bbe = localStorage.getItem("NotificationRemoved_" +  NotificationID);
        if (bbe) {
            bbe = bbe.split(",")[1] === BEACON.notifications.ShownState.REMOVED ? true : false;
        } else {
            bbe = false;
        }
        return bbe;
    },

    SetBlockingNotificationShown: function (NotificationID) {
        sessionStorage.setItem(BEACON.notifications.CORE.SessionStoragePrefix + "BlockingNotificationShown", "1");
        sessionStorage.setItem(BEACON.notifications.CORE.SessionStoragePrefix + "BlockingNotification", NotificationID);
    },

    HasBlockingNotificationBeenShown: function (NotificationID) {
        if (sessionStorage.getItem(BEACON.notifications.CORE.SessionStoragePrefix + "BlockingNotificationShown") === "1") {

            //Check to see if the current notificaiton is the blocking notification for this session
            if (sessionStorage.getItem(BEACON.notifications.CORE.SessionStoragePrefix + "BlockingNotification") == NotificationID) {
                //we want to display this notification so return false
                return false;
            }
            else {
                return true;
            }
        }
        else {
            return false;
        }
    },

    SetPreviousNotificationsProcessed: function () {
        sessionStorage.setItem(BEACON.notifications.CORE.SessionStoragePrefix + "PreviousNotificationsProcessed", "1");
    },

    HasPreviousNotificationsProcessed: function () {
        var bbe = sessionStorage.getItem(BEACON.notifications.CORE.SessionStoragePrefix + "PreviousNotificationsProcessed") == "1" ? true : false;
        return bbe;
    },

    //Find the notification by notifications ID
    NotificationObjectById: function (notificationID) {
        var arrPos = -1;
        var rtnPos = -1;
        var rtnNotification;
        $.each(BEACON.notifications.CORE.NotificationsArray, function (index, notification) {
            arrPos++;
            if (notification.NotificationID == notificationID)
                rtnNotification = notification;
        });
        return rtnNotification;
    }

};

//The methods for removing a notification from memory are in their own namespace
BEACON.notifications.CORE.Remove = {

    Notification: function (notificationID) {
        //This method will call an AJAX request which will set a flag to remove the notification from the shade
        //It will also remove the notificationID and notificationobject from in memory arrays.

        var PostData = "r=1";
        PostData += "&";
        PostData += "ClientNotificationGuid=" + encodeURIComponent(BEACON.notifications.CORE.ClientNotificationGuid);
        PostData += "&";
        PostData += "NotificationID=" + encodeURIComponent(notificationID);
        BEACON.xhrPost("notifications.aspx", PostData, BEACON.notifications.CORE.Remove.ProcessRemoval);
    },

    NotificationAndRedirect: function (notificationID, href) {
        var PostData = "r=1";
        PostData += "&";
        PostData += "ClientNotificationGuid=" + encodeURIComponent(BEACON.notifications.CORE.ClientNotificationGuid);
        PostData += "&";
        PostData += "NotificationID=" + encodeURIComponent(notificationID);
        BEACON.xhrPost("notifications.aspx", PostData, function (returnJSON) {

            BEACON.notifications.CORE.Remove.ProcessRemoval(returnJSON);
            window.location.href = href;
        });
    },

    ProcessRemoval: function (returnJSON) {
        if (returnJSON.Success == 1) //on a success callback this will then remove the notification from the memory in javascript (so it won't load again).
            BEACON.notifications.CORE.Remove.RemoveNotificationFromMemory(returnJSON.NotificationID);
    },

    RemoveNotificationFromMemory: function (notificationID) {//This function removed the notification from the array and list of notifications
        var PositionInNotificationArray = BEACON.notifications.CORE.Remove.FindIndexOfNotificationInArray(notificationID);
        if (PositionInNotificationArray > -1) {
            BEACON.notifications.CORE.NotificationsArray.splice(PositionInNotificationArray, 1); //remove from the list of notifications
            BEACON.notifications.CORE.SetNotificationRemoved(notificationID);
        }
    },

    //Find the position of a notification within the system array from the notifications ID
    FindIndexOfNotificationInArray: function (notificationID) {
        var arrPos = -1;
        var rtnPos = -1;
        $.each(BEACON.notifications.CORE.NotificationsArray, function (index, notification) {
            arrPos++;
            if (notification.NotificationID == notificationID)
                rtnPos = arrPos; //Return position if notification found
        });

        return rtnPos; //return -1 if not found
    },

    // Removes all outdated/expired notificaiton_remove states.
    ClearOutdatedStatesFromMemory: function () {
        const now = new Date();
        for (var currentElement in localStorage) {
            if (currentElement.split('_')[0] == "NotificationRemoved") {
                const expiryDate = localStorage[currentElement].split(",")[2];
                if (now.getTime() > new Date(expiryDate)) {
                    localStorage.removeItem("NotificationRemoved_" +  currentElement.split('_')[1]);
                }
            }
         }
    }

}


///
///  UI
///

BEACON.notifications.UI = { //The UI object handles displaying and positioning a notification, fading out a notification etc

    initialized: false,
    UpdateNotificationsWithNewData: false, //Tells the UI if it should update any existing notifications

    NOTIFICATION_FADEIN: 800, //Time for the notification to fade in
    NOTIFICATION_FADEOUT: 250, //Time for the notification to fade out
    NOTIFICATION_DISPLAYFOR: 5000, //Show notification for 5 seconds

    SND_DING: function () { try { return new Audio("/sorce/Beacon/sounds/chimes.mp3"); } catch (err) { return false; } },
    SND_MUTE: false,
    setCookie: function (name, value, days) {
        var expires = "";
        if (days) {
            var date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
            expires = "; expires=" + date.toUTCString();
        }
        document.cookie = name + "=" + (value || "") + expires + "; path=/";
    },
    getCookie: function (name) {
        var nameEQ = name + "=";
        var ca = document.cookie.split(';');
        for (var i = 0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) == ' ') c = c.substring(1, c.length);
            if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
        }
        return null;
    },
    eraseCookie: function (name) {
        document.cookie = name + '=; Max-Age=-99999999;';
    },

    Startup: function () {
        $('body').append(BEACON.notifications.Glare.HTML()); //Create the notifications glare object
        $('#beaconToolbarItemWrapperAlerts').append(BEACON.notifications.Shade.HTML()); //Create the notifications shade object
        try {
            BEACON.notifications.UI.SND_MUTE = BEACON.notifications.UI.getCookie(BEACON.notifications.CORE.SessionStoragePrefix + "Mute") == "yes";
            if (BEACON.notifications.UI.SND_MUTE) {
                $("#notificationsMuteToggle").removeClass("volume-up");
                $("#notificationsMuteToggle").addClass("mute");
            } else {
                $("#notificationsMuteToggle").addClass("volume-up");
                $("#notificationsMuteToggle").removeClass("mute");
            }
        }
        catch (err) {
            BEACON.notifications.UI.SND_MUTE = false;
            BEACON.notifications.UI.setCookie(BEACON.notifications.CORE.SessionStoragePrefix + "Mute", "no", 9999);
        }
        BEACON.notifications.UI.initialized = true;
    },

    toggleMute: function () {
        var toggleElem = $("#notificationsMuteToggle")
        if (BEACON.notifications.UI.SND_MUTE) {
            BEACON.notifications.UI.SND_MUTE = false;
            BEACON.notifications.UI.setCookie(BEACON.notifications.CORE.SessionStoragePrefix + "Mute", "no", 9999);
            toggleElem.addClass("volume-up");
            toggleElem.removeClass("mute");
        } else {
            BEACON.notifications.UI.SND_MUTE = true;
            BEACON.notifications.UI.setCookie(BEACON.notifications.CORE.SessionStoragePrefix + "Mute", "yes", 9999);
            toggleElem.removeClass("volume-up");
            toggleElem.addClass("mute");
        }
    },

    SetNotificationsCount: function (notificationCount) {
        try {
            if (isNaN(notificationCount)) {
                document.getElementById("BEACON_Toolbar_Alerts_Count").innerHTML = "";
                document.getElementById("BEACON_Toolbar_Alerts_Count").setAttribute("class", "ToolbarAlertsCountNone");
            }
            else {
                if (notificationCount > 0) {
                    var currentInner = document.getElementById("BEACON_Toolbar_Alerts_Count").innerText.trim();
                    document.getElementById("BEACON_Toolbar_Alerts_Count").innerHTML = "&nbsp;" + notificationCount;
                    document.getElementById("BEACON_Toolbar_Alerts_Count").setAttribute("class", "ToolbarAlertsCountSome");
                    $(".beaconToolbarItemWrapperAlerts").addClass("some");
                    if (!isNaN(currentInner) && parseInt(currentInner) < notificationCount) {
                        $('#BEACON_Toolbar_Alerts_Count').parent().effect('bounce', { distance: 20 }, 750);
                        if (!BEACON.notifications.UI.SND_MUTE) BEACON.notifications.UI.SND_DING.play();
                    }
                } else {
                    document.getElementById("BEACON_Toolbar_Alerts_Count").innerHTML = "";
                    document.getElementById("BEACON_Toolbar_Alerts_Count").setAttribute("class", "ToolbarAlertsCountNone");
                    $(".beaconToolbarItemWrapperAlerts").removeClass("some");
                }
            }
        } catch (err) { }

        //if (!isMobile) {try { document.getElementById("sorceAlertsCount").innerHTML = BEACON.alerts.numberOfSORCEAlerts; }catch (err){}};

    },

    ContainerHasAvailableSpace: function (containterObject) {
        //Check to make sure there is enough room to create a new alert
        var percent60WindowHeight = $(window).height() * 0.6;
        var notificationsHolderHeight = $(containterObject).height();

        if (notificationsHolderHeight < percent60WindowHeight) {
            return true;
        }
        else {
            return false;
        }
    },

    DisplayInstrusiveNotification: function (notification) {
        $('body').append(BEACON.notifications.NotificationObjects.Intrusive(notification));

    },

    DisplayBlockingNotification: function (notification) {
        $('body').append(BEACON.notifications.NotificationObjects.Blocking(notification));

    },

    DisplayNotificationInGlare: function (notification) {
        if (!isMobileApp || (isMobileApp && notification.Stored === false)) {
            //Check to make sure notification does not already exist before creating a new one
            var obj = $('#' + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notification.NotificationID).html();
            if (typeof (obj) == "undefined" && !BEACON.notifications.CORE.HasNotificationBeenRemoved(notification.NotificationID) &&
                !BEACON.notifications.CORE.HasNotificationBeenShown(notification.NotificationID)) {

                //Create the new Informational notification to show in the notifications glare
                BEACON.notifications.Glare.Add(BEACON.notifications.NotificationObjects.Informational(notification));

                //If notification is not sticky, set notification to remove itself after a set time
                if (notification.Sticky === false) {
                    //BEACON.notifications.UI.Shown(notification.NotificationID);
                    notification.FadeOut = setTimeout(function () { BEACON.notifications.UI.DismissNotification(notification.NotificationID); }, BEACON.notifications.UI.NOTIFICATION_DISPLAYFOR);
                }

            }
        }

    },

    DisplayNotificationInShade: function (notification) {
        if (!isMobileApp) {
            //Create the new Informational notification to show in the notifications shade
            BEACON.notifications.Shade.Add(notification.NotificationID, BEACON.notifications.NotificationObjects.Informational(notification), notification.Sticky);

            //Set the notification to having been seen, so these stored/sticky notificatinos won't display again in the Glare
            BEACON.notifications.UI.Shown(notification.NotificationID);

            //Stop any fadeout from happening in the shade
            notification.StopFadeOut();
        }
    },

    DoesNotificationAlreadyExist: function (notification) {
        var obj = $('#' + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notification.NotificationID).html();
        if (typeof (obj) != "undefined") {
            return true;
        }
        else {
            return false;
        }
    },

    UpdateNotificationInPage: function (notificationObject) {
        if (BEACON.notifications.UI.UpdateNotificationsWithNewData === true) { //Update only if the update flag been switched on
            //get the current notification object in the page
            var objectID = BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationObject.NotificationID;
            var notifyObj = $("#" + objectID);

            //double check the object exists before trying to replace it.
            if (typeof (notifyObj.html()) != "undefined") {
                //when on notification page also show in view all page item
                if (BEACON.notifications.CORE.ViewAllPageActive === true) {
                    $("#all_" + objectID).replaceWith(BEACON.notifications.NotificationObjects.ViewAll(notificationObject, "all_"));
                }
                //Replace with the new data depending on notification type
                switch (notificationObject.Type) {
                    case BEACON.notifications.types.INFORMATIONAL:
                        notifyObj[0].innerHTML = $(BEACON.notifications.NotificationObjects.Informational(notificationObject))[0].innerHTML;
                        break;

                    case BEACON.notifications.types.INTRUSIVE:
                        notifyObj[0].innerHTML = $(BEACON.notifications.NotificationObjects.Intrusive(notificationObject))[0].innerHTML;
                        break;
                }
            }
        }
    },


    DismissBlockingNotification: function (notificationID) {

        BEACON.notifications.CORE.SetNotificationShown(notificationID);

        $(".notificationBlockingContainer").fadeOut(function () {
            $(".notificationBlockingContainer").remove();
            BEACON.notifications.CORE.ActiveBlockingNotification = false;
        });
    },

    DismissIntrusiveNotification: function (notificationID) {
        $(".notificationIntrusiveContainer").fadeOut(function () {
            $(".notificationIntrusiveContainer").remove();
            BEACON.notifications.CORE.ActiveIntrusiveNotification = false;
        });

        //lets mark it as seen in the database
        BEACON.notifications.CORE.Remove.Notification(notificationID);
    },

    DismissNotification: function (notificationID, href)
    {
        //This is called for informational notifications when they timeout.
        //It is also called when the x is pressed on an informational notification either in the shade or in the glare

        var isStored = false;

        try { isStored = BEACON.notifications.CORE.NotificationObjectById(notificationID).Stored } catch (err) { };

        var allNotifyObj = $("#all_" + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationID);
        if (allNotifyObj) allNotifyObj.removeClass("unseen");


        var notifyObj = $("#" + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationID);
        notifyObj.css("min-height", 0); //set min height for the object to be 0 - so the slideUp method works ok.
        notifyObj.slideUp(BEACON.notifications.UI.NOTIFICATION_FADEOUT, function () {
            //remove the object
            notifyObj.remove();

            //if the shade is active and the current notificationid is in the shade - run the dismiss from shade processes
            if (BEACON.notifications.Shade.Active === true && $.inArray(notificationID, BEACON.notifications.Shade.NotificationsCurrentlyInShade) !== -1) {
                if (href === undefined) {
                    BEACON.notifications.UI.DismissNotificationFromShade(notificationID);
                } else {
                    BEACON.notifications.CORE.Remove.NotificationAndRedirect(notificationID, href);
                }
            } else if (BEACON.notifications.Shade.Active === false && href != undefined) {
                BEACON.notifications.CORE.Remove.NotificationAndRedirect(notificationID, href);
            }

        });

        if (!isStored) {
            BEACON.notifications.CORE.Remove.Notification(notificationID);
        } else {
            //Tell the CORE to set the notification to have been seen - this will also set sticky notifications as having been seen when they are removed
            BEACON.notifications.UI.Shown(notificationID);
        }

    },

    DismissNotificationFromShade: function (notificationID) {
        //Remove the notification from memory - this also flags the notification as removed in the database, so it will only show on the 'view all' page.
        BEACON.notifications.CORE.Remove.Notification(notificationID);

        //Remove from shade
        BEACON.notifications.UI.RemoveNotificationFromShade(notificationID);
    },

    RemoveNotificationFromShade: function (notificationID) {
        //Remove item from NotificationsCurrentlyInShade array
        BEACON.notifications.Shade.NotificationsCurrentlyInShade.splice($.inArray(notificationID, BEACON.notifications.Shade.NotificationsCurrentlyInShade), 1);

        if (BEACON.notifications.Shade.NotificationsCurrentlyInShade.length == 0) {
            //Check notifications left in the shade
            BEACON.notifications.Shade.ShowNoActiveNotifications();
        }
    },

    DismissNotificationFromViewAll: function (notificationID) {

        var allNotifyObj = $("#all_" + BEACON.notifications.NotificationObjects.NotificationIDPrefix + notificationID);
        allNotifyObj.css("min-height", 0); //set min height for the object to be 0 - so the slideUp method works ok.
        allNotifyObj.slideUp(BEACON.notifications.UI.NOTIFICATION_FADEOUT, function () { });

        //Remove notification from the shade, which also sets it as seen
        BEACON.notifications.UI.DismissNotification(notificationID);

        //Remove the notification from memory - this also flags the notification as removed in the database, so it will only show on the 'view all' page.
        BEACON.notifications.CORE.Remove.Notification(notificationID);

        //Delete the notification from the database
        var PostData = "r=4";
        PostData += "&";
        PostData += "NotificationID=" + encodeURIComponent(notificationID);
        BEACON.xhrPost("notifications.aspx", PostData);

    },

    Shown: function (notificationID) {
        //Tell the CORE to set the notification to have been seen IF there is not an active blocking or intrusive notification
        if (BEACON.notifications.CORE.ActiveBlockingNotification !== true || BEACON.notifications.CORE.ActiveIntrusiveNotification !== true)
            BEACON.notifications.CORE.SetNotificationShown(notificationID);
    }


};





BEACON.notifications.All = {

    NotificationsContainer: '',

    AllNotificationsArray: new Array(),

    init: function (NotificationContainerID) { //initalise the view all subroutines.

        //Note in the system that we are on the view all page.
        BEACON.notifications.CORE.ViewAllPageActive = true;

        BEACON.notifications.All.LoadMainNotificationPreferences();

        //Get the container inwhich to render the view all objects
        BEACON.notifications.All.NotificationsContainer = $('#' + NotificationContainerID)

        //Get the notifications
        BEACON.notifications.All.RetrieveNotifications();

    },

    LoadMainNotificationPreferences: function () {
        var PostData = "r=6";
        BEACON.xhrPost("notifications.aspx?", PostData, BEACON.notifications.All.RenderMainNotificationPreferences);
    },

    RenderMainNotificationPreferences: function (prefsJSON) {
        var mainPrefHeader = document.getElementsByName("NotificationMainPreferencesContainer")[0];

        var turnOff_unchecked = document.getElementsByName("NotificationMainPreferencesTurnOff_unchecked")[0];
        var turnOff_checked = document.getElementsByName("NotificationMainPreferencesTurnOff_checked")[0];
        var turnOff_value = document.getElementsByName("NotificationMainPreferencesTurnOff_value")[0];
        var email_unchecked = document.getElementsByName("NotificationMainPreferencesEmail_unchecked")[0];
        var email_checked = document.getElementsByName("NotificationMainPreferencesEmail_checked")[0];
        var email_value = document.getElementsByName("NotificationMainPreferencesEmail_value")[0];
        var popup_unchecked = document.getElementsByName("NotificationMainPreferencesPopup_unchecked")[0];
        var popup_checked = document.getElementsByName("NotificationMainPreferencesPopup_checked")[0];
        var popup_value = document.getElementsByName("NotificationMainPreferencesPopup_value")[0];
        var individual_unchecked = document.getElementsByName("NotificationMainPreferencesIndividual_unchecked")[0];
        var individual_checked = document.getElementsByName("NotificationMainPreferencesIndividual_checked")[0];
        var individual_value = document.getElementsByName("NotificationMainPreferencesIndividual_value")[0];

        if (prefsJSON.receivePopup) {
            popup_unchecked.style.display = "none";
            popup_checked.style.display = "inline-block";
            popup_value.value = "1";
        } else {
            popup_unchecked.style.display = "inline-block";
            popup_checked.style.display = "none";
            popup_value.value = "0";
        }

        if (prefsJSON.receiveEmail) {
            email_unchecked.style.display = "none";
            email_checked.style.display = "inline-block";
            email_value.value = "1";
        } else {
            email_unchecked.style.display = "inline-block";
            email_checked.style.display = "none";
            email_value.value = "0";
        }

        if (prefsJSON.receiveNone) {
            turnOff_unchecked.style.display = "none";
            turnOff_checked.style.display = "inline-block";
            turnOff_value.value = "1";
        } else {
            turnOff_unchecked.style.display = "inline-block";
            turnOff_checked.style.display = "none";
            turnOff_value.value = "0";
        }

        if (turnOff_value.value == "0" && popup_value.value == "0" && email_value.value == "0") {
            individual_unchecked.style.display = "none";
            individual_checked.style.display = "inline-block";
            individual_value.value = "1";
        } else {
            individual_unchecked.style.display = "inline-block";
            individual_checked.style.display = "none";
            individual_value.value = "0";
        }

    },

    ToggleMainPref: function (which, onOff) {
        $("div[name='notificationPrefsPopdown']").hide();
        var turnOff_unchecked = document.getElementsByName("NotificationMainPreferencesTurnOff_unchecked")[0];
        var turnOff_checked = document.getElementsByName("NotificationMainPreferencesTurnOff_checked")[0];
        var turnOff_value = document.getElementsByName("NotificationMainPreferencesTurnOff_value")[0];
        var email_unchecked = document.getElementsByName("NotificationMainPreferencesEmail_unchecked")[0];
        var email_checked = document.getElementsByName("NotificationMainPreferencesEmail_checked")[0];
        var email_value = document.getElementsByName("NotificationMainPreferencesEmail_value")[0];
        var popup_unchecked = document.getElementsByName("NotificationMainPreferencesPopup_unchecked")[0];
        var popup_checked = document.getElementsByName("NotificationMainPreferencesPopup_checked")[0];
        var popup_value = document.getElementsByName("NotificationMainPreferencesPopup_value")[0];
        var individual_unchecked = document.getElementsByName("NotificationMainPreferencesIndividual_unchecked")[0];
        var individual_checked = document.getElementsByName("NotificationMainPreferencesIndividual_checked")[0];
        var individual_value = document.getElementsByName("NotificationMainPreferencesIndividual_value")[0];


        switch (which) {
            case "turnOff":
                if (onOff == "on") {
                    turnOff_unchecked.style.display = "none";
                    turnOff_checked.style.display = "inline-block";
                    turnOff_value.value = "1";
                    email_unchecked.style.display = "inline-block";
                    email_checked.style.display = "none";
                    email_value.value = "0";
                    popup_unchecked.style.display = "inline-block";
                    popup_checked.style.display = "none";
                    popup_value.value = "0";
                } else if (onOff == "off") {
                    turnOff_unchecked.style.display = "inline-block";
                    turnOff_checked.style.display = "none";
                    turnOff_value.value = "0";
                }
                break;
            case "email":
                if (onOff == "on") {
                    turnOff_unchecked.style.display = "inline-block";
                    turnOff_checked.style.display = "none";
                    turnOff_value.value = "0";
                    email_unchecked.style.display = "none";
                    email_checked.style.display = "inline-block";
                    email_value.value = "1";
                } else if (onOff = "off") {
                    email_unchecked.style.display = "inline-block";
                    email_checked.style.display = "none";
                    email_value.value = "0";
                }
                break;
            case "popup":
                if (onOff == "on") {
                    turnOff_unchecked.style.display = "inline-block";
                    turnOff_checked.style.display = "none";
                    turnOff_value.value = "0";
                    popup_unchecked.style.display = "none";
                    popup_checked.style.display = "inline-block";
                    popup_value.value = "1";
                } else if (onOff = "off") {
                    popup_unchecked.style.display = "inline-block";
                    popup_checked.style.display = "none";
                    popup_value.value = "0";
                }
                break;
            case "individual":
                //Actual individual box is managed at the end
                turnOff_unchecked.style.display = "inline-block";
                turnOff_checked.style.display = "none";
                turnOff_value.value = "0";
                email_unchecked.style.display = "inline-block";
                email_checked.style.display = "none";
                email_value.value = "0";
                popup_unchecked.style.display = "inline-block";
                popup_checked.style.display = "none";
                popup_value.value = "0";
                break;
        }

        if (turnOff_value.value == "0" && popup_value.value == "0" && email_value.value == "0") {
            individual_unchecked.style.display = "none";
            individual_checked.style.display = "inline-block";
            individual_value.value = "1";
        } else {
            individual_unchecked.style.display = "inline-block";
            individual_checked.style.display = "none";
            individual_value.value = "0";
        }

        BEACON.notifications.All.UpdateMainNotificationPreferences();
    },

    UpdateMainNotificationPreferences: function () {
        var turnOff_value_value = document.getElementsByName("NotificationMainPreferencesTurnOff_value")[0].value;
        var email_value_value = document.getElementsByName("NotificationMainPreferencesEmail_value")[0].value;
        var popup_value_value = document.getElementsByName("NotificationMainPreferencesPopup_value")[0].value;

        //var PostData = "r=7,turnOff=" & turnOff_value_value & ",email=" & email_value_value & ",popup=" & popup_value_value;
        var PostData = { r: "7", turnOff: turnOff_value_value, email: email_value_value, popup: popup_value_value }
        BEACON.xhrPost("notifications.aspx?", PostData);
    },

    ToggleChannelPref: function (which, onOff, idPart, channelString) {
        var turnOff_unchecked = document.getElementById("turnOff_off_" + idPart);
        var turnOff_checked = document.getElementById("turnOff_on_" + idPart);
        var turnOff_value = document.getElementById("turnOff_value_" + idPart);
        var email_unchecked = document.getElementById("email_off_" + idPart);
        var email_checked = document.getElementById("email_on_" + idPart);
        var email_value = document.getElementById("email_value_" + idPart);
        var popup_unchecked = document.getElementById("popup_off_" + idPart);
        var popup_checked = document.getElementById("popup_on_" + idPart);
        var popup_value = document.getElementById("popup_value_" + idPart);

        var sameChan_turnOff_unchecked = document.getElementsByName("turnOff_off_" + channelString);
        var sameChan_turnOff_checked = document.getElementsByName("turnOff_on_" + channelString);
        var sameChan_turnOff_value = document.getElementsByName("turnOff_value_" + channelString);
        var sameChan_email_unchecked = document.getElementsByName("email_off_" + channelString);
        var sameChan_email_checked = document.getElementsByName("email_on_" + channelString);
        var sameChan_email_value = document.getElementsByName("email_value_" + channelString);
        var sameChan_popup_unchecked = document.getElementsByName("popup_off_" + channelString);
        var sameChan_popup_checked = document.getElementsByName("popup_on_" + channelString);
        var sameChan_popup_value = document.getElementsByName("popup_value_" + channelString);

        var i;



        switch (which) {
            case "turnOff":
                if (onOff == "on") {
                    for (i = 0; i < sameChan_turnOff_unchecked.length; i++) { sameChan_turnOff_unchecked[i].style.display = "none"; }
                    for (i = 0; i < sameChan_turnOff_checked.length; i++) { sameChan_turnOff_checked[i].style.display = "inline-block"; }
                    for (i = 0; i < sameChan_turnOff_value.length; i++) { sameChan_turnOff_value[i].value = "1"; }
                    for (i = 0; i < sameChan_email_unchecked.length; i++) { sameChan_email_unchecked[i].style.display = "inline-block"; }
                    for (i = 0; i < sameChan_email_checked.length; i++) { sameChan_email_checked[i].style.display = "none"; }
                    for (i = 0; i < sameChan_email_value.length; i++) { sameChan_email_value[i].value = "0"; }
                    for (i = 0; i < sameChan_popup_unchecked.length; i++) { sameChan_popup_unchecked[i].style.display = "inline-block"; }
                    for (i = 0; i < sameChan_popup_checked.length; i++) { sameChan_popup_checked[i].style.display = "none"; }
                    for (i = 0; i < sameChan_popup_value.length; i++) { sameChan_popup_value[i].value = "0"; }
                } else if (onOff == "off") {
                    for (i = 0; i < sameChan_turnOff_unchecked.length; i++) { sameChan_turnOff_unchecked[i].style.display = "inline-block"; }
                    for (i = 0; i < sameChan_turnOff_checked.length; i++) { sameChan_turnOff_checked[i].style.display = "none"; }
                    for (i = 0; i < sameChan_turnOff_value.length; i++) { sameChan_turnOff_value[i].value = "0"; }
                }
                break;
            case "email":
                if (onOff == "on") {
                    for (i = 0; i < sameChan_turnOff_unchecked.length; i++) { sameChan_turnOff_unchecked[i].style.display = "inline-block"; }
                    for (i = 0; i < sameChan_turnOff_checked.length; i++) { sameChan_turnOff_checked[i].style.display = "none"; }
                    for (i = 0; i < sameChan_turnOff_value.length; i++) { sameChan_turnOff_value[i].value = "0"; }
                    for (i = 0; i < sameChan_email_unchecked.length; i++) { sameChan_email_unchecked[i].style.display = "none"; }
                    for (i = 0; i < sameChan_email_checked.length; i++) { sameChan_email_checked[i].style.display = "inline-block"; }
                    for (i = 0; i < sameChan_email_value.length; i++) { sameChan_email_value[i].value = "1"; }
                } else if (onOff = "off") {
                    for (i = 0; i < sameChan_email_unchecked.length; i++) { sameChan_email_unchecked[i].style.display = "inline-block"; }
                    for (i = 0; i < sameChan_email_checked.length; i++) { sameChan_email_checked[i].style.display = "none"; }
                    for (i = 0; i < sameChan_email_value.length; i++) { sameChan_email_value[i].value = "0"; }
                }
                break;
            case "popup":
                if (onOff == "on") {
                    for (i = 0; i < sameChan_turnOff_unchecked.length; i++) { sameChan_turnOff_unchecked[i].style.display = "inline-block"; }
                    for (i = 0; i < sameChan_turnOff_checked.length; i++) { sameChan_turnOff_checked[i].style.display = "none"; }
                    for (i = 0; i < sameChan_turnOff_value.length; i++) { sameChan_turnOff_value[i].value = "0"; }
                    for (i = 0; i < sameChan_popup_unchecked.length; i++) { sameChan_popup_unchecked[i].style.display = "none"; }
                    for (i = 0; i < sameChan_popup_checked.length; i++) { sameChan_popup_checked[i].style.display = "inline-block"; }
                    for (i = 0; i < sameChan_popup_value.length; i++) { sameChan_popup_value[i].value = "1"; }
                } else if (onOff = "off") {
                    for (i = 0; i < sameChan_popup_unchecked.length; i++) { sameChan_popup_unchecked[i].style.display = "inline-block"; }
                    for (i = 0; i < sameChan_popup_checked.length; i++) { sameChan_popup_checked[i].style.display = "none"; }
                    for (i = 0; i < sameChan_popup_value.length; i++) { sameChan_popup_value[i].value = "0"; }
                }
                break;
        }

        BEACON.notifications.All.UpdateChannelNotificationPreferences(idPart, channelString);
    },

    toggleChannelPrefsPopDown: function (idPart) {
        var individual_value_value = document.getElementsByName("NotificationMainPreferencesIndividual_value")[0].value;
        if (individual_value_value == "1") {
            $('#prefs_' + idPart).toggle();
        } else {
            $('#prefs_' + idPart + '_disabled').toggle();
        }
    },

    UpdateChannelNotificationPreferences: function (idPart, channelString) {
        var turnOff_value_value = document.getElementById("turnOff_value_" + idPart).value;
        var email_value_value = document.getElementById("email_value_" + idPart).value;
        var popup_value_value = document.getElementById("popup_value_" + idPart).value;

        var PostData = { r: "8", turnOff: turnOff_value_value, email: email_value_value, popup: popup_value_value, channelString: channelString }
        BEACON.xhrPost("notifications.aspx?", PostData);
    },

    RetrieveNotifications: function () {
        var PostData = "r=2";
        BEACON.xhrPost("notifications.aspx?", PostData, BEACON.notifications.All.PopulateAllNotifications);
    },

    TogglePreferences: function () {
        $(document.getElementsByName("NotificationMainPreferencesContainer")[0]).toggle();
    },


    PopulateAllNotifications: function (notificationJSON) {

        BEACON.notifications.All.AllNotificationsArray = notificationJSON;

        if (typeof (notificationJSON) != "undefined") {
            var previousSeen = false;
            $.each(notificationJSON, function (index, value) {

                if (value.ChannelGroupString == "") value.ChannelGroupString = "ZZZZZZUNGROUPEDZZZZZZ";

                if (value.Stored) {
                    if ($("#all_" + BEACON.notifications.NotificationObjects.NotificationIDPrefix + value.NotificationID).length == 0) {
                        BEACON.notifications.All.DisplayNotificationObject(BEACON.notifications.CORE.ProcessNotification(value), false, previousSeen);
                        previousSeen = value.DbSeen;
                    }
                }
            });
        }
    },

    RePopulateAllNotifications: function (notificationJSON, sortByGroup) {

        BEACON.notifications.All.AllNotificationsArray = notificationJSON;

        if (typeof (notificationJSON) != "undefined") {
            var previousSeen = false;
            $.each(notificationJSON, function (index, value) {
                if (value.Stored) {
                    BEACON.notifications.All.DisplayNotificationObject(BEACON.notifications.CORE.ProcessNotification(value), sortByGroup, previousSeen);
                    previousSeen = value.DbSeen;
                }
            });
        }
    },

    DisplayNotificationObject: function (notification, sortByGroup, previousSeen) {

        if (sortByGroup) {

            var ChannelGroupString = notification.ChannelGroupString;
            if (ChannelGroupString == "ZZZZZZUNGROUPEDZZZZZZ") ChannelGroupString = "Ungrouped";

            var groupContainer = document.getElementById("ChannelGroup_" + ChannelGroupString);
            if (!groupContainer) {
                groupContainer = document.createElement("DIV");
                groupContainer.setAttribute("class", "contentContainer bottomPad_large bottomMargin_medium topMargin_medium");
                groupContainer.setAttribute("id", "ChannelGroup_" + ChannelGroupString);
                groupContainer.innerHTML = "<h4>" + ChannelGroupString + ":</h4>";
                BEACON.notifications.All.NotificationsContainer.append(groupContainer);
            } else {
                if (previousSeen && notification.DbSeen) {
                    $(groupContainer).append("<DIV class=\"notificationSeparator\">");
                }
            }
            $(groupContainer).append(BEACON.notifications.NotificationObjects.ViewAll(notification, "all_"));
        }
        else {
            if (previousSeen && notification.DbSeen) {
                BEACON.notifications.All.NotificationsContainer.append("<DIV class=\"notificationSeparator\">");
            }
            BEACON.notifications.All.NotificationsContainer.append(BEACON.notifications.NotificationObjects.ViewAll(notification, "all_"));
        }

    },

    SortByChannelGroupString: function () {
        BEACON.notifications.All.AllNotificationsArray.sort(function (a, b) {
            if (a.ChannelGroupString + a.StandardSortOrder < b.ChannelGroupString + b.StandardSortOrder)
                return -1;
            if (a.ChannelGroupString + a.StandardSortOrder > b.ChannelGroupString + b.StandardSortOrder)
                return 1;
            return 0;
        });

        BEACON.notifications.All.reRender(true);

        $("div[name=notifyHeader_viewByMostRecent]").removeClass("viewByHeaderSelection");
        $("div[name=notifyHeader_viewByMostRecent]").addClass("viewByHeader");

        $("div[name=notifyHeader_viewByChannelGroup]").addClass("viewByHeaderSelection");
        $("div[name=notifyHeader_viewByChannelGroup]").removeClass("viewByHeader");

    },

    SortByDate: function () {
        BEACON.notifications.All.AllNotificationsArray.sort(function (a, b) {
            if (a.StandardSortOrder < b.StandardSortOrder)
                return -1;
            if (a.StandardSortOrder > b.StandardSortOrder)
                return 1;
            return 0;
        });

        BEACON.notifications.All.reRender(false);

        $("div[name=notifyHeader_viewByMostRecent]").addClass("viewByHeaderSelection");
        $("div[name=notifyHeader_viewByMostRecent]").removeClass("viewByHeader");

        $("div[name=notifyHeader_viewByChannelGroup]").removeClass("viewByHeaderSelection");
        $("div[name=notifyHeader_viewByChannelGroup]").addClass("viewByHeader");

    },

    reRender: function (sortByGroup) {
        BEACON.notifications.All.NotificationsContainer[0].innerHTML = "";
        BEACON.notifications.All.RePopulateAllNotifications(BEACON.notifications.All.AllNotificationsArray, sortByGroup);
    }

}

